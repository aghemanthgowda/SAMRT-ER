# ---------------------------------------------------------------------------
# SMART-ER environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
# ---------------------------------------------------------------------------

# --- Google Maps Platform ---------------------------------------------------
# Required for the real map. Enable "Maps JavaScript API" and "Routes API"
# on the key, and restrict it to your origins.
# https://developers.google.com/maps/documentation/javascript/get-api-key
#
# Without a key the application still boots and runs the full simulation
# against a clearly labelled DEMO MAP fallback.
GOOGLE_MAPS_API_KEY=

# The web app reads the Vite-prefixed variable. Set it to the same key.
VITE_GOOGLE_MAPS_API_KEY=

# Maps JS API version channel. The Routes library (google.maps.routes) is
# published on the `beta` channel; `weekly` falls back to DirectionsService.
VITE_GOOGLE_MAPS_VERSION=beta

# Optional Map ID for cloud-based map styling (vector maps / Advanced Markers).
VITE_GOOGLE_MAPS_MAP_ID=

# --- Ports ------------------------------------------------------------------
# Move the whole stack off a pair of ports something else is holding by
# changing these two. The web dev server proxies /api to PORT, so they stay in
# step automatically. Vite now fails outright if WEB_PORT is taken rather than
# quietly taking the next one — a new front end talking to an old API is how a
# change appears not to have worked.
PORT=4000
WEB_PORT=5173

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
NODE_ENV=development

# Signing secret for API tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A development-only fallback is used when unset; production refuses to boot.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Where the browser reaches this deployment. Password-reset links are built
# from it, so it must point at the web app rather than at the API.
APP_BASE_URL=http://localhost:5173

# --- Storage ----------------------------------------------------------------
# SQLite file holding operational state, credentials and run history. Defaults
# to `data/smart-er.db`, created on first boot. The directory is git-ignored —
# the file contains password hashes and must never be committed.
#
# Set to an empty string to run entirely in memory, which reseeds on every
# restart. Tests always run in memory regardless of this setting.
DATABASE_PATH=

# Password assigned to every seeded operator account on first boot. It is
# bcrypt-hashed before it is stored; the plaintext is never persisted, never
# returned by the API and never shown in the interface. Must satisfy the same
# policy as a chosen password (at least 12 characters). It applies only to a
# database with no accounts in it — once seeded, changing this does nothing.
# Change it before any deployment reachable from outside your machine.
SEED_PASSWORD=

# --- Simulation -------------------------------------------------------------
# Simulation tick interval in milliseconds.
SIM_TICK_MS=1000
# Wall-clock speed multiplier for demos (1 = real time, 4 = 4x faster).
SIM_SPEED=1

# --- Web --------------------------------------------------------------------
# Base URL of the SMART-ER API as seen from the browser.
VITE_API_BASE_URL=http://localhost:4000

# --- Phase 2 (hardware) — not used while running in simulation --------------
# Transport for real ESP32 junction controllers once hardware is connected.
# HARDWARE_TRANSPORT=simulated   # simulated | mqtt | websocket
# MQTT_BROKER_URL=
# MQTT_USERNAME=
# MQTT_PASSWORD=
