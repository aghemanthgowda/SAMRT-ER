# dependencies
node_modules/
.npm/

# build output
dist/
build/
*.tsbuildinfo

# environment — never commit real keys
.env
.env.*
!.env.example

# test / coverage
coverage/
.vitest/

# logs
*.log
npm-debug.log*
logs/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# runtime state — the SQLite database holds operational history and password
# hashes, so it must never be committed
data/
*.db
*.db-shm
*.db-wal
apps/server/data/*.json
!apps/server/data/.gitkeep
